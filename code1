#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>

int main(void) {
	FILE* fp = fopen("input.txt", "r");
	if (!fp) {
		printf("open file error");

		return 1;
	}
	int count;
	int seat[10] = { 0 };
	int success = 0;

	if(fscanf(fp, "%d", &count) == 1)
	{	
		printf("전체 예약 시도:%d\n", count);
	}

	for (int i = 0; i < count; i++) {
		int seat_no;
		 if(fscanf(fp, "%d", &seat_no) == 1) {
			printf("예약 시도중인 좌석 번호: %d\n", seat_no);
		}

		 if (seat[seat_no - 1] == 0) {
			 seat[seat_no - 1] = 1;
			 success++;
		 }
	}
	printf("%d\n", success);

	for (int i = 0; i < 10; i++) {
		printf("%d ", seat[i]);
	}
	fclose(fp);
	return 0;

}
