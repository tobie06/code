{
    Book*head = NULL;
    int menu;
    FILE* fp = fopen("input.txt", "r");

    if (fp == NULL)
    {
        printf("Failed to open file\n");
        return 1;
    }
    while (1)
    {
        printf("\n========== 도서 관리 시스템 ==========\n");
        printf("1. 도서 등록\n");
        printf("2. 도서 삭제\n");
        printf("3. 전체 도서 조회\n");
        printf("4. 도서 검색\n");
        printf("5. 도서 정보 수정\n");
        printf("6. 도서 대출\n");
        printf("7. 도서 반납\n");
        printf("0. 프로그램 종료\n");
        printf("======================================\n");
        printf("선택: ");

        fscanf(INPUT, "%d", &menu);

        switch (menu)
        {
        case 1:
            printf("도서 등록을 선택하셨습니다\n");
            Book *book = creatBook();
            addBook(&head, book);
            printBook(book);
