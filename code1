#define _CRT_SECURE_NO_WARNINGS
#include<stdio.h>
#include<stdlib.h>

#define INPUT stdin
//#define INPUT fp

typedef struct Book {
    int id;
    char title[100];
    char author[50];
    int year;
    int available;
    struct Book* nextBook;
} Book;

Book *creatBook() {
    Book *book =malloc(sizeof(Book));
    if (book == NULL) {
        printf("메모리 할당 실패\n");
        return NULL;
    }
    printf("도서 ID: ");
    fscanf(INPUT, "%d", &(book->id));
    printf("도서 제목: ");
    fscanf(INPUT, "%s", book->title);
    printf("저자: ");
    fscanf(INPUT, "%s", book->author);
    printf("도서 출반연도: ");
    fscanf(INPUT, "%d", &(book->year));
    return book;

}

void addBook(Book**head,Book* book) {
    int new_id = book->id;
    Book* current_book = *head;
    while (current_book != NULL) {
        if (current_book->id == new_id) {
            printf("이미 존재하는 책입니다");
            free(book);
            return;
        }
        current_book = current_book->nextBook;
    }
    book->nextBook = *head;
    *head = book;
}

void deleteBook(Book** head) {
    int id;
    printf("삭제할 책의 ID: ");
    fscanf(INPUT, "%d", &id);

    Book* current_book = *head;

    if (current_book->id == id) {
        *head = current_book->nextBook;
        free(current_book);
        printf("맨 앞에 있는 책을 삭제했습니다");
        return;
    }
    Book* prev_book = NULL;
    while (current_book != NULL) {
        if (current_book->id == id) {
            prev_book->nextBook = current_book->nextBook;
            free(current_book);
            printf("삭제 완료되었습니다");
            return;
        }
        prev_book = current_book;
        current_book = current_book->nextBook;
    }
}



void printBook(Book *book) {

        printf("\n========== 도서 정보 ==========\n");
        printf("도서 ID: %d\n", book->id);
        printf("도서 제목: %s\n", book->title);
        printf("저자: %s\n", book->author);
        printf("출판연도: %d\n", book->year);
}


